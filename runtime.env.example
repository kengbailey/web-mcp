# Web MCP runtime settings. Copy to runtime.env, chmod 600, fill in values
# outside chat/logs. Every key is optional; tools whose provider is unset return
# "ERROR NOT_CONFIGURED".

# Search (search, search_videos). EXA_SEARCH_TYPE: fast (default) | auto | lite | neural
EXA_API_KEY=
# EXA_SEARCH_TYPE=fast

# Reddit app-only OAuth: create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:web-mcp:v3

# YouTube Data API key: official metadata, and required for fetch_youtube_comments
YOUTUBE_API_KEY=

# Speech-to-text fallback for transcripts (OpenRouter by default).
# Parakeet covers 25 European languages; others use STT_FALLBACK_MODEL.
STT_ENDPOINT=https://openrouter.ai/api/v1
STT_MODEL=nvidia/parakeet-tdt-0.6b-v3
STT_FALLBACK_MODEL=openai/whisper-large-v3-turbo
STT_API_KEY=
# STT_MAX_SECONDS=14400

# Egress routing. PROXY_URL: web pages. REDDIT_PROXY_URL: Reddit only (does not
# inherit PROXY_URL). YOUTUBE_PROXY_URL: unset inherits PROXY_URL, empty = direct.
PROXY_URL=
REDDIT_PROXY_URL=
YOUTUBE_PROXY_URL=

# Output and server
# DEFAULT_MAX_CHARS=8000     # default chunk for fetch_content/read_content/transcripts
# BROWSER_PREWARM=1          # launch Chromium at startup (faster first JS/blocked page)
MCP_TRANSPORT=http

# Optional authentication (leave absent for LAN mode). See doc/cloud-auth.md.
# MCP_AUTHKIT_DOMAIN=
# MCP_BASE_URL=
# MCP_RESOURCE_URL=
# MCP_MACHINE_SECRET=
# MCP_MACHINE_ISSUER=webintel-internal
# MCP_REQUIRED_SCOPES=
